{
  "name": "unlinked",
  "version": "1.0.0",
  "description": "Search your owner-scoped imported network and the complete published professional People index with an explicitly revocable account grant.",
  "homepage": "https://www.unlinked.ai",
  "transports": {
    "streamable-http": {
      "url": "https://www.unlinked.ai/mcp"
    }
  },
  "authentication": {
    "type": "bearer",
    "setupUrl": "https://www.unlinked.ai/settings"
  },
  "tools": [
    {
      "name": "unlinked_search_network",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "unlinked_search_everyone",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false
      }
    }
  ]
}
